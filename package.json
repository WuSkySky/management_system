{
  "name": "production-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "preview": "vite preview --host 127.0.0.1",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply management-system --local",
    "db:migrate:remote": "wrangler d1 migrations apply management-system --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
